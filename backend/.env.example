# 產生方式: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
WEBHOOK_BASE_URL=https://your-tunnel-domain.com
DB_PATH=data/data.db
ADMIN_PASSWORD=
DEALER_CONTACT_INFO=如需購車相關服務，請聯繫業務窗口：(02)1234-5678
# 需開通 Sheets API + Drive API。OAuth token 由 scripts/google_oauth_setup.py
# 一次性授權產生（見該檔案說明），不是服務帳號金鑰
GOOGLE_OAUTH_TOKEN_PATH=google-oauth-token.json
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# 系統異常（NotebookLM 查詢失敗、Google 紀錄寫入失敗、tunnel 掛掉又恢復等）時，
# 主動推送 LINE 訊息通知管理員。ADMIN_LINE_USER_ID 是你自己的 LINE userId，
# ADMIN_ALERT_ACCESS_TOKEN 是任一個已綁定頻道的 channel access token（你必須是
# 該官方帳號的好友才收得到 push 訊息）。留空則不啟用告警。
ADMIN_LINE_USER_ID=
ADMIN_ALERT_ACCESS_TOKEN=