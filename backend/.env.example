# development 可用 localhost；正式部署請改為 production。
ENVIRONMENT=development

# 產生方式: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# production 必填且必須固定備份，不能每次啟動重產。
ENCRYPTION_KEY=
WEBHOOK_BASE_URL=https://your-tunnel-domain.com
DB_PATH=data/data.db
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NOTEBOOK_HOST_ALLOWLIST=notebooklm.google.com,notebooklm.google,notebook.google.com

SETUP_SESSION_TTL_SECONDS=3600
ADMIN_SESSION_TTL_SECONDS=900
INVITE_CODE_TTL_SECONDS=7776000
NOTEBOOK_QUERY_CONCURRENCY=3
NOTEBOOK_QUERY_QUEUE_LIMIT=20
NOTEBOOK_CHAT_TIMEOUT_SECONDS=180
NOTEBOOK_QUERY_TIMEOUT_SECONDS=210
LINE_BACKGROUND_TASK_LIMIT=100
LINE_BACKGROUND_SHUTDOWN_TIMEOUT_SECONDS=15
LINE_WEBHOOK_MAX_BODY_BYTES=1048576
LINE_WEBHOOK_MAX_EVENTS_PER_REQUEST=100
LINE_EVENT_DEDUPE_RETENTION_SECONDS=604800
LINE_EVENT_CLAIM_TIMEOUT_SECONDS=720
LINE_EVENT_PENDING_LIMIT=5000
LINE_EVENT_PENDING_PER_CHANNEL_LIMIT=50
LINE_EVENT_REPLAY_PER_CHANNEL_BATCH=10
LINE_EVENT_MAX_ATTEMPTS=4
LINE_EVENT_RETRY_BASE_SECONDS=5
LINE_EVENT_REPLAY_INTERVAL_SECONDS=2
LINE_EVENT_PENDING_RETENTION_SECONDS=86400
COURSE_ACCOUNT_HEALTH_CHECK_INTERVAL_SECONDS=900

SHARED_NOTEBOOK_BINDING_ENABLED=true
LEGACY_NLM_BINDING_ENABLED=false

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_INVITE_ATTEMPTS=10
RATE_LIMIT_ADMIN_LOGIN_ATTEMPTS=5
RATE_LIMIT_CHANNEL_UPDATES=10
RATE_LIMIT_NOTEBOOK_BINDINGS=5
RATE_LIMIT_COURSE_ACCOUNT_REAUTH=5

# 只有後端確實只接受受信任反向代理流量時才啟用。
TRUST_PROXY_HEADERS=false
